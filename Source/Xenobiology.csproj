<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build: dotnet build -c Release -p:KSPDIR="C:\path\to\Kerbal Space Program"
       Output goes straight to GameData/Xenobiology/Plugins. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Xenobiology</AssemblyName>
    <RootNamespace>Xenobiology</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <KSPDIR Condition="'$(KSPDIR)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Kerbal Space Program</KSPDIR>
    <KSPManaged>$(KSPDIR)\KSP_x64_Data\Managed</KSPManaged>
    <OutputPath>..\GameData\Xenobiology\Plugins\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <NoWarn>CS0414;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(KSPManaged)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(KSPManaged)\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="$(KSPManaged)\UnityEngine*.dll" Private="false" />
  </ItemGroup>
</Project>
